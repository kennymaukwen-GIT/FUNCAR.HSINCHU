{
  "redirects": [
    {
      "source": "/models.html",
      "destination": "/about.html#contact",
      "permanent": true
    },
    {
      "source": "/car-detail.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[a-z0-9-]+)"
        }
      ],
      "destination": "/cars/:id.html",
      "permanent": true
    },
    {
      "source": "/import-tax-calculator.html",
      "destination": "/import-guide.html",
      "permanent": true
    },
    {
      "source": "/incoming.html",
      "destination": "/inventory.html#coming",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/about.html#contact",
      "permanent": true
    }
  ]
}
